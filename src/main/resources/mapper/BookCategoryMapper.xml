<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.inkisle.mapper.BookCategoryMapper">

    <!-- sort 为表内维护的排序号，不用 id 排序，以便手动调整分类顺序 -->
    <select id="selectAll" resultType="com.inkisle.entity.BookCategory">
        SELECT id, category_name, parent_id, sort
        FROM book_category
        ORDER BY sort ASC
    </select>

</mapper>
