<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.inkisle.mapper.BookInfoMapper">

    <!--
      列名为下划线、实体字段为驼峰，能自动映射的原因是 application.yml 中开启了
      map-underscore-to-camel-case，book_name 会映射到 bookName。
      开启该开关后无需为每张表手写 resultMap。
    -->
    <sql id="Base_Column_List">
        id, book_name, author_name, author_id, category_id, book_desc, cover_url, status,
        audit_status, audit_remark, create_time, update_time
    </sql>

    <!--
      读者端可见性：只认 book_info.audit_status = 2（已通过）。
      早先的判断方式是每行执行一次「取最新审核记录」的相关子查询，
      既走不了索引，count 还要再扫一遍；状态收敛到本表一列后，
      条件退化为普通列比较，可直接命中 idx_audit_status。
      2 与 BookAuditStatus.PASSED 对应，XML 里引用不到 Java 枚举，改动时两处需同步。
      空值按不可见处理：状态缺失时宁可不上架，也不漏出未审内容。
    -->
    <sql id="Audit_Visible">
        audit_status = 2
    </sql>

    <!--
      书库列表的过滤条件：分类筛选 + 仅展示已上架作品。
      categoryId 为 null 时 if 标签内不拼接，仅保留可见性条件。
      外层使用 where 标签而非手写 WHERE 1=1，多余的 AND 由 MyBatis 去除。
    -->
    <sql id="Library_Where">
        <where>
            <if test="categoryId != null">
                AND category_id = #{categoryId}
            </if>
            AND <include refid="Audit_Visible"/>
        </where>
    </sql>

    <!--
      关键词搜索：书名或作者名命中关键字，同样只查已上架的作品。
      两字及以上走全文索引（MATCH ... AGAINST + BOOLEAN MODE），索引必须配 ngram 分词器，
      否则中文整句会被当成一个词，查询无结果。ngram 最小切分长度为 2，
      单字仍匹配不到，故补一段 LIKE 兜底。
      LIKE 分支的括号不能省：它是 A OR B，后面还要 AND 可见性条件，
      缺括号会变成 A OR (B AND 可见)，未上架作品的作者名命中也会漏出。
    -->
    <sql id="Keyword_Where">
        <where>
            <choose>
                <when test="keyword != null and keyword.length() &gt;= 2">
                    MATCH(book_name, author_name) AGAINST(#{keyword} IN BOOLEAN MODE)
                </when>
                <otherwise>
                    (book_name LIKE CONCAT('%', #{keyword}, '%')
                    OR author_name LIKE CONCAT('%', #{keyword}, '%'))
                </otherwise>
            </choose>
            AND <include refid="Audit_Visible"/>
        </where>
    </sql>

    <!-- LIMIT 的两个参数同样使用 #{}，被预编译为 ?，不以字符串拼接 -->
    <select id="selectPage" resultType="com.inkisle.entity.BookInfo">
        SELECT
        <include refid="Base_Column_List"/>
        FROM book_info
        <include refid="Library_Where"/>
        ORDER BY create_time DESC
        LIMIT #{offset}, #{pageSize}
    </select>

    <select id="countByCategory" resultType="int">
        SELECT COUNT(*) FROM book_info
        <include refid="Library_Where"/>
    </select>

    <select id="selectById" resultType="com.inkisle.entity.BookInfo">
        SELECT
        <include refid="Base_Column_List"/>
        FROM book_info
        WHERE id = #{id}
    </select>

    <!--
      追加章节前先锁住作品行：取最大章节号与插入之间若不加锁，
      两个并发请求会读到同一个最大值，写出两个相同的章节号。
      唯一索引 uk_book_id_chapter_num 兜底，这里是让冲突不发生而不是发生后再报错。
    -->
    <select id="selectIdForUpdate" resultType="java.lang.Long">
        SELECT id FROM book_info WHERE id = #{id} FOR UPDATE
    </select>

    <select id="searchByKeyword" resultType="com.inkisle.entity.BookInfo">
        SELECT
        <include refid="Base_Column_List"/>
        FROM book_info
        <include refid="Keyword_Where"/>
        ORDER BY create_time DESC
        LIMIT #{offset}, #{pageSize}
    </select>

    <select id="countByKeyword" resultType="int">
        SELECT COUNT(*) FROM book_info
        <include refid="Keyword_Where"/>
    </select>

    <select id="selectByAuthorId" resultType="com.inkisle.entity.BookInfo">
        SELECT
        <include refid="Base_Column_List"/>
        FROM book_info
        WHERE author_id = #{authorId}
        ORDER BY id DESC
    </select>

    <insert id="insert" parameterType="com.inkisle.entity.BookInfo" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO book_info (book_name, author_name, author_id, category_id, book_desc, cover_url, status,
                               audit_status, create_time, update_time)
        VALUES (#{bookName}, #{authorName}, #{authorId}, #{categoryId}, #{bookDesc}, #{coverUrl}, #{status},
                #{auditStatus}, #{createTime}, #{updateTime})
    </insert>

    <!--
      编辑只覆盖展示字段。audit_status / audit_remark 不在这里改：
      它们由审核流程单独维护（updateAuditStatus），混进来就会被编辑操作覆盖，
      与 status 曾经被写成 null 是同一类问题。
    -->
    <update id="updateById" parameterType="com.inkisle.entity.BookInfo">
        UPDATE book_info
        SET book_name = #{bookName},
            author_name = #{authorName},
            category_id = #{categoryId},
            book_desc = #{bookDesc},
            cover_url = #{coverUrl},
            status = #{status},
            update_time = #{updateTime}
        WHERE id = #{id}
    </update>

    <update id="updateStatus" parameterType="com.inkisle.entity.BookInfo">
        UPDATE book_info
        SET status = #{status},
            update_time = #{updateTime}
        WHERE id = #{id}
    </update>

    <!--
      上架状态的唯一写入口。auditRemark 无条件覆盖：
      通过时传 null 正好清掉上一次的驳回意见，避免作者看到过期的原因。
    -->
    <update id="updateAuditStatus">
        UPDATE book_info
        SET audit_status = #{auditStatus},
            audit_remark = #{auditRemark},
            update_time = #{updateTime}
        WHERE id = #{id}
    </update>

    <!-- 管理端按上架状态查书：审核通过名单用于下架，已下架名单用于恢复 -->
    <select id="selectByAuditStatus" resultType="com.inkisle.entity.BookInfo">
        SELECT
        <include refid="Base_Column_List"/>
        FROM book_info
        WHERE audit_status = #{auditStatus}
        ORDER BY update_time DESC, id DESC
        LIMIT #{offset}, #{pageSize}
    </select>

    <select id="countByAuditStatus" resultType="int">
        SELECT COUNT(*) FROM book_info
        WHERE audit_status = #{auditStatus}
    </select>

    <delete id="deleteById">
        DELETE FROM book_info
        WHERE id = #{id}
    </delete>

</mapper>
