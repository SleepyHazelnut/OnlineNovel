<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.inkisle.mapper.BookInfoMapper">

    <sql id="Base_Column_List">
        id, book_name, author_name, category_id, book_desc, cover_url, status, create_time, update_time
    </sql>

    <select id="selectPage" resultType="com.inkisle.entity.BookInfo">
        SELECT
        <include refid="Base_Column_List"/>
        FROM book_info
        ORDER BY create_time DESC
        LIMIT #{offset}, #{pageSize}
    </select>

    <select id="countAll" resultType="int">
        SELECT COUNT(*) FROM book_info
    </select>

    <select id="selectById" resultType="com.inkisle.entity.BookInfo">
        SELECT
        <include refid="Base_Column_List"/>
        FROM book_info
        WHERE id = #{id}
    </select>

</mapper>
