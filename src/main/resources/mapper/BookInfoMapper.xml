<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.inkisle.mapper.BookInfoMapper">

    <sql id="Base_Column_List">
        id, book_name, author_name, category_id, book_desc, cover_url, status, create_time, update_time
    </sql>

    <!-- 按分类筛选和查全部走同一条 SQL，categoryId 为空时 where 不生效 -->
    <sql id="Category_Where">
        <where>
            <if test="categoryId != null">
                category_id = #{categoryId}
            </if>
        </where>
    </sql>

    <!-- 搜索条件：书名或作者名包含关键字 -->
    <sql id="Keyword_Where">
        <where>
            book_name LIKE CONCAT('%', #{keyword}, '%')
            OR author_name LIKE CONCAT('%', #{keyword}, '%')
        </where>
    </sql>

    <select id="selectPage" resultType="com.inkisle.entity.BookInfo">
        SELECT
        <include refid="Base_Column_List"/>
        FROM book_info
        <include refid="Category_Where"/>
        ORDER BY create_time DESC
        LIMIT #{offset}, #{pageSize}
    </select>

    <select id="countByCategory" resultType="int">
        SELECT COUNT(*) FROM book_info
        <include refid="Category_Where"/>
    </select>

    <select id="selectById" resultType="com.inkisle.entity.BookInfo">
        SELECT
        <include refid="Base_Column_List"/>
        FROM book_info
        WHERE id = #{id}
    </select>

    <select id="searchByKeyword" resultType="com.inkisle.entity.BookInfo">
        SELECT
        <include refid="Base_Column_List"/>
        FROM book_info
        <include refid="Keyword_Where"/>
        ORDER BY create_time DESC
        LIMIT #{offset}, #{pageSize}
    </select>

    <select id="countByKeyword" resultType="int">
        SELECT COUNT(*) FROM book_info
        <include refid="Keyword_Where"/>
    </select>

</mapper>
