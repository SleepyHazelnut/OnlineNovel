<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.inkisle.mapper.BookContentMapper">

    <!-- 正文表与章节表一对一，通过 chapter_id 关联。大文本独立建表，
         避免拖慢列表与目录查询 -->
    <select id="selectByChapterId" resultType="com.inkisle.entity.BookContent">
        SELECT id, chapter_id, content
        FROM book_content
        WHERE chapter_id = #{chapterId}
    </select>

    <insert id="insert" parameterType="com.inkisle.entity.BookContent" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO book_content (chapter_id, content)
        VALUES (#{chapterId}, #{content})
    </insert>

    <!-- 整本导入：正文随章节一起批量写，不再一章一次往返 -->
    <insert id="insertBatch">
        INSERT INTO book_content (chapter_id, content)
        VALUES
        <foreach collection="contents" item="item" separator=",">
            (#{item.chapterId}, #{item.content})
        </foreach>
    </insert>

    <update id="updateByChapterId" parameterType="com.inkisle.entity.BookContent">
        UPDATE book_content
        SET content = #{content}
        WHERE chapter_id = #{chapterId}
    </update>

    <delete id="deleteByChapterId">
        DELETE FROM book_content
        WHERE chapter_id = #{chapterId}
    </delete>

    <!--
      作品删除时按其全部章节清掉正文。用子查询按 book_id 定位，
      免去先把章节 id 全查回 Java 再拼 IN，章节再多也只是一条 SQL
    -->
    <delete id="deleteByBookId">
        DELETE FROM book_content
        WHERE chapter_id IN (SELECT id FROM book_chapter WHERE book_id = #{bookId})
    </delete>

</mapper>
